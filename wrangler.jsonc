{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "realtvsize",
	"main": "./src/worker.js",
	"compatibility_date": "2026-08-27",
	"assets": {
		"directory": "./dist/",
		"binding": "ASSETS",
		"run_worker_first": true,
		"html_handling": "drop-trailing-slash",
		"not_found_handling": "404-page"
	}
}
