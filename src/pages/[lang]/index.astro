---
import WillItFit from '../../components/WillItFit.astro';
import FaqSection from '../../components/FaqSection.astro';
import SeoContent from '../../components/SeoContent.astro';
import CatalogDiscovery from '../../components/CatalogDiscovery.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import TVComparison from '../../components/TVComparison.astro';
import TVSizeRecommender from '../../components/TVSizeRecommender.astro';
import ViewingDistanceSimulator from '../../components/ViewingDistanceSimulator.astro';
import WhyVisualization from '../../components/WhyVisualization.astro';
import { homeFaqs } from '../../data/home-faq';
import { getLanguageStaticPaths, type Language } from '../../i18n/config';
import type { Translation } from '../../i18n/types';
import Layout from '../../layouts/Layout.astro';

export const getStaticPaths = getLanguageStaticPaths;

interface Props {
	lang: Language;
	t: Translation;
}

const { lang, t } = Astro.props;
const isEnglish = lang === 'en';
const description = isEnglish
	? 'Free TV size calculator. Visualize screen sizes, compare dimensions, explore viewing distance and check whether your next TV fits your space.'
	: `${t.comparison.intro} ${t.tools.featureText}`;
const structuredData = isEnglish
	? {
		'@context': 'https://schema.org',
		'@graph': [
			{
				'@type': 'WebApplication',
				'@id': 'https://realtvsize.com/en#calculator',
				name: 'RealTVSize TV Size Calculator',
				url: 'https://realtvsize.com/en',
				description,
				applicationCategory: 'UtilitiesApplication',
				operatingSystem: 'Any',
				browserRequirements: 'Requires JavaScript',
				offers: {
					'@type': 'Offer',
					price: '0',
					priceCurrency: 'USD',
				},
				featureList: [
					'TV size comparison',
					'Viewing distance simulation',
					'Room-based TV size recommendation',
					'16:9 screen dimension calculations',
					'Front-facing TV fit checks',
					'Overlay comparison, metric and imperial units, and setup links',
				],
			},
			{
				'@type': 'WebSite',
				'@id': 'https://realtvsize.com/#website',
				url: 'https://realtvsize.com/',
				name: 'RealTVSize',
				inLanguage: 'en',
			},
			{
				'@type': 'FAQPage',
				'@id': 'https://realtvsize.com/en#faq',
				mainEntity: homeFaqs.map((item) => ({
					'@type': 'Question',
					name: item.question,
					acceptedAnswer: {
						'@type': 'Answer',
						text: item.answer,
					},
				})),
			},
		],
	}
	: undefined;
---

<Layout title={t.pageTitles.home} lang={lang} page="home" t={t} description={description} structuredData={structuredData}>
	<TVComparison t={t} />
	<ViewingDistanceSimulator t={t} />
	<TVSizeRecommender t={t} />
	<WillItFit t={t} />
	<WhyVisualization t={t} />
	{isEnglish && <SeoContent />}
	{isEnglish && <FaqSection />}
	<CatalogDiscovery lang={lang} current="home" />
	<RelatedTools lang={lang} current="home" />
</Layout>
