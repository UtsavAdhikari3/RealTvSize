---
import ViewingDistanceSimulator from '../../components/ViewingDistanceSimulator.astro';
import ToolGuide from '../../components/ToolGuide.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import { toolSeo, calculatorSchema } from '../../data/tool-seo';
import { getLanguageStaticPaths, type Language } from '../../i18n/config';
import type { Translation } from '../../i18n/types';
import Layout from '../../layouts/Layout.astro';

export const getStaticPaths = getLanguageStaticPaths;

interface Props {
	lang: Language;
	t: Translation;
}

const { lang, t } = Astro.props;
---

<Layout title={t.pageTitles.viewingDistance} lang={lang} page="viewingDistance" t={t} description={lang === 'en' ? toolSeo.viewingDistance.description : undefined} structuredData={lang === 'en' ? calculatorSchema(toolSeo.viewingDistance.heading, toolSeo.viewingDistance.description, '/en/viewing-distance') : undefined}>
	<ViewingDistanceSimulator t={t} primaryHeading heading={lang === 'en' ? toolSeo.viewingDistance.heading : undefined} intro={lang === 'en' ? `Move the couch. Feel the difference. ${t.viewingDistance.intro}` : undefined} />
	{lang === 'en' && <><ToolGuide tool="viewingDistance" /><RelatedTools current="viewingDistance" /></>}
</Layout>
