---
import StaticContentPage from '../../components/StaticContentPage.astro';
import { staticPages } from '../../data/static-pages';
import { getLanguageStaticPaths, type Language } from '../../i18n/config';
import type { Translation } from '../../i18n/types';
import Layout from '../../layouts/Layout.astro';

export const getStaticPaths = getLanguageStaticPaths;

interface Props {
	lang: Language;
	t: Translation;
}

const { lang, t } = Astro.props;
const content = staticPages.contact;
const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'ContactPage',
	name: t.navigation.contact,
	description: content.description,
	url: `https://realtvsize.com/${lang}/contact`,
};
---

<Layout title={t.pageTitles.contact} lang={lang} page="contact" t={t} description={content.description} structuredData={structuredData}>
	<StaticContentPage title={t.navigation.contact} {...content} />
</Layout>
