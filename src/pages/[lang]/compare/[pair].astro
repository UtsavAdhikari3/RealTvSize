---
import Layout from '../../../layouts/Layout.astro';
import TVComparison from '../../../components/TVComparison.astro';
import SeoReference from '../../../components/SeoReference.astro';
import SeoBreadcrumbs from '../../../components/SeoBreadcrumbs.astro';
import FaqSection from '../../../components/FaqSection.astro';
import CatalogDiscovery from '../../../components/CatalogDiscovery.astro';
import RelatedTools from '../../../components/RelatedTools.astro';
import { comparisons, type Comparison } from '../../../data/catalog';
import { getLanguageStaticPaths, type Language } from '../../../i18n/config';
import type { Translation } from '../../../i18n/types';
import { getSeoCopy, pairContent, detailSchema, type Crumb } from '../../../data/seo';
export function getStaticPaths() {
 return getLanguageStaticPaths().flatMap(({ params, props }) => comparisons.map(comparison => ({
  params: { ...params, pair: comparison.slug }, props: { ...props, comparison },
 })));
}
interface Props { lang: Language; t: Translation; comparison: Comparison }
const { lang, t, comparison } = Astro.props;
const copy = await getSeoCopy(lang), content = pairContent(copy, comparison, lang), page = comparison.slug;
const crumbs: Crumb[] = [{ name: t.navigation.home, page: 'home' }, { name: copy.labels.comparisons, page: 'compare' }, { name: content.heading, page }];
const structuredData = detailSchema(Astro.site!, lang, page, content, crumbs);
---
<Layout lang={lang} t={t} page={page} title={content.title} description={content.description} structuredData={structuredData}>
 <SeoBreadcrumbs lang={lang} label={copy.labels.breadcrumb} crumbs={crumbs} />
 <TVComparison t={t} heading={content.heading} intro={content.intro} initialA={comparison.a} initialB={comparison.b} />
 <SeoReference lang={lang} t={t} copy={copy} sizes={[comparison.a, comparison.b]} content={content} />
 <FaqSection heading={copy.labels.faq} eyebrow={copy.labels.answers} intro="" entries={content.faqs} />
 <CatalogDiscovery lang={lang} current={page} pairSizes={[comparison.a, comparison.b]} />
 <RelatedTools lang={lang} current={page} />
</Layout>
