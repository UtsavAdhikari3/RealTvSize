---
import StaticContentPage from '../../components/StaticContentPage.astro';
import { staticPages } from '../../data/static-pages';
import { getLanguageStaticPaths, type Language } from '../../i18n/config';
import type { Translation } from '../../i18n/types';
import Layout from '../../layouts/Layout.astro';

export const getStaticPaths = getLanguageStaticPaths;

interface Props {
	lang: Language;
	t: Translation;
}

const { lang, t } = Astro.props;
const content = staticPages.about;
const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'AboutPage',
	name: t.navigation.about,
	description: content.description,
	url: `https://realtvsize.com/${lang}/about`,
	mainEntity: {
		'@type': 'Organization',
		name: 'RealTVSize',
		url: 'https://realtvsize.com/',
	},
};
---

<Layout title={t.pageTitles.about} lang={lang} page="about" t={t} description={content.description} structuredData={structuredData}>
	<StaticContentPage title={t.navigation.about} {...content} />
</Layout>
