---
import StaticContentPage from '../../components/StaticContentPage.astro';
import { staticPages } from '../../data/static-pages';
import { getLanguageStaticPaths, type Language } from '../../i18n/config';
import type { Translation } from '../../i18n/types';
import Layout from '../../layouts/Layout.astro';

export const getStaticPaths = getLanguageStaticPaths;

interface Props {
	lang: Language;
	t: Translation;
}

const { lang, t } = Astro.props;
const content = staticPages.privacyPolicy;
const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'WebPage',
	name: t.navigation.privacyPolicy,
	description: content.description,
	url: `https://realtvsize.com/${lang}/privacy-policy`,
};
---

<Layout title={t.pageTitles.privacyPolicy} lang={lang} page="privacyPolicy" t={t} description={content.description} structuredData={structuredData}>
	<StaticContentPage title={t.navigation.privacyPolicy} {...content} />
</Layout>
