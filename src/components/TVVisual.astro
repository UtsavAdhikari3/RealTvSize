---
interface Props {
	id?: string;
	ariaLabel: string;
	size?: number;
	scale?: number;
	stand?: boolean;
	compact?: boolean;
}

const { id, ariaLabel, scale = 1, stand = true, compact = false } = Astro.props;
---

<div
	id={id}
	class:list={['tv-set', { 'tv-set--compact': compact }]}
	style={`--tv-scale:${scale}`}
	role="img"
	aria-label={ariaLabel}
	data-tv-visual
>
	<div class="tv-body">
		<div class="tv-screen" aria-hidden="true">
			<div class="screen-glow"></div>
			<div class="screen-sun"></div>
			<div class="screen-ridge ridge-back"></div>
			<div class="screen-ridge ridge-front"></div>
			<div class="screen-reflection"></div>
		</div>
		<div class="tv-brand" aria-hidden="true"></div>
	</div>
	{stand && (
		<div class="tv-stand" aria-hidden="true">
			<span class="stand-neck"></span>
			<span class="stand-foot"></span>
		</div>
	)}
</div>

<style>
	.tv-set {
		width: 100%;
		transform: scale(var(--tv-scale, 1));
		transform-origin: center bottom;
		transition: transform 260ms cubic-bezier(0.22, 1, 0.36, 1);
		filter: drop-shadow(0 18px 24px rgb(0 0 0 / 0.13));
	}

	.tv-body {
		position: relative;
		aspect-ratio: 16 / 9;
		padding: clamp(3px, 0.7vw, 7px);
		border-radius: clamp(5px, 0.8vw, 10px);
		background: linear-gradient(145deg, var(--tv-edge), var(--tv-bezel) 28%, #050506 75%);
		box-shadow:
			inset 0 0 0 1px rgb(255 255 255 / 0.11),
			inset 0 -2px 4px rgb(0 0 0 / 0.7),
			0 1px 1px rgb(0 0 0 / 0.35);
	}

	.tv-screen {
		position: relative;
		width: 100%;
		height: 100%;
		overflow: hidden;
		border-radius: clamp(2px, 0.35vw, 5px);
		background:
			radial-gradient(circle at 67% 25%, rgb(255 191 117 / 0.8), transparent 13%),
			linear-gradient(153deg, #0b1934 0%, #16446d 42%, #d7886c 100%);
		box-shadow: inset 0 0 24px rgb(0 0 0 / 0.35);
	}

	.screen-glow {
		position: absolute;
		inset: 0;
		background: linear-gradient(120deg, rgb(89 222 255 / 0.12), transparent 42%, rgb(255 179 121 / 0.18));
	}

	.screen-sun {
		position: absolute;
		top: 19%;
		left: 66%;
		width: 8%;
		aspect-ratio: 1;
		border-radius: 50%;
		background: #ffd9a3;
		box-shadow: 0 0 20px rgb(255 206 145 / 0.8);
	}

	.screen-ridge {
		position: absolute;
		left: -8%;
		width: 116%;
		clip-path: polygon(0 58%, 10% 46%, 20% 52%, 32% 27%, 41% 50%, 53% 22%, 65% 52%, 76% 34%, 88% 54%, 100% 41%, 100% 100%, 0 100%);
	}

	.ridge-back {
		bottom: 19%;
		height: 54%;
		background: #203a4c;
		opacity: 0.72;
	}

	.ridge-front {
		bottom: -1%;
		height: 58%;
		background: linear-gradient(#102c3b, #07161f);
		clip-path: polygon(0 68%, 14% 47%, 25% 61%, 39% 32%, 52% 60%, 68% 42%, 78% 62%, 91% 44%, 100% 55%, 100% 100%, 0 100%);
	}

	.screen-reflection {
		position: absolute;
		inset: 0;
		background: linear-gradient(105deg, rgb(255 255 255 / 0.16), transparent 24%, transparent 66%, rgb(255 255 255 / 0.05));
		mix-blend-mode: screen;
	}

	.tv-brand {
		position: absolute;
		bottom: 1px;
		left: 50%;
		width: 2px;
		height: 1px;
		border-radius: 999px;
		background: #8d8f94;
		transform: translateX(-50%);
	}

	.tv-stand {
		position: relative;
		height: clamp(10px, 3vw, 30px);
	}

	.stand-neck {
		position: absolute;
		top: 0;
		left: 50%;
		width: 2.8%;
		height: 64%;
		min-width: 3px;
		background: linear-gradient(90deg, #17181b, #4e5157 50%, #131416);
		transform: translateX(-50%);
	}

	.stand-foot {
		position: absolute;
		bottom: 2%;
		left: 50%;
		width: 28%;
		height: 18%;
		min-height: 3px;
		border-radius: 100% 100% 30% 30%;
		background: linear-gradient(#505258, #111215);
		box-shadow: 0 5px 8px rgb(0 0 0 / 0.2);
		transform: translateX(-50%) perspective(80px) rotateX(45deg);
	}

	.tv-set--compact {
		filter: drop-shadow(0 8px 10px rgb(0 0 0 / 0.2));
	}

	.tv-set--compact .tv-body {
		padding: clamp(2px, 0.4vw, 4px);
	}
</style>
