---
import type { Language } from '../i18n/config';
import { localizedPath } from '../i18n/routes';
import type { Translation } from '../i18n/types';

interface Props {
	lang: Language;
	t: Translation;
}

const { lang, t } = Astro.props;
---

<footer class="site-shell py-10 sm:py-14">
	<div class="flex flex-col gap-8 border-b border-[var(--line)] pb-10 sm:flex-row sm:items-center sm:justify-between">
		<div>
			<a href={localizedPath(lang, 'home')} class="inline-flex items-center gap-2 text-sm font-semibold tracking-[-0.02em] text-[var(--text)]" translate="no">
				<span class="grid size-6 place-items-center rounded-md bg-[var(--text)] text-[var(--page-bg)]" aria-hidden="true">
					<svg viewBox="0 0 24 24" class="size-3.5" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="12" rx="1.5"></rect><path d="M9 21h6M12 17v4"></path></svg>
				</span>
				RealTVSize
			</a>
			<p class="mt-3 text-sm text-[var(--text-tertiary)]">{t.footer.tagline}</p>
		</div>
		<nav aria-label={t.navigation.footerLabel} class="flex flex-wrap gap-x-5 gap-y-3 text-sm text-[var(--text-secondary)]">
			<a class="hover:text-[var(--text)]" href={localizedPath(lang, 'compare')}>{t.navigation.compare}</a>
			<a class="hover:text-[var(--text)]" href={localizedPath(lang, 'viewingDistance')}>{t.navigation.viewingDistance}</a>
			<a class="hover:text-[var(--text)]" href={localizedPath(lang, 'findMyTvSize')}>{t.navigation.findMyTvSize}</a>
			<a class="hover:text-[var(--text)]" href={localizedPath(lang, 'about')}>{t.navigation.about}</a>
			<a class="hover:text-[var(--text)]" href={localizedPath(lang, 'contact')}>{t.navigation.contact}</a>
			<a class="hover:text-[var(--text)]" href={localizedPath(lang, 'privacyPolicy')}>{t.navigation.privacyPolicy}</a>
			<a class="hover:text-[var(--text)]" href={localizedPath(lang, 'termsAndConditions')}>{t.navigation.termsAndConditions}</a>
		</nav>
	</div>
	<div class="flex flex-col gap-2 pt-6 font-mono text-[10px] text-[var(--text-tertiary)] sm:flex-row sm:items-center sm:justify-between">
		<p>{t.footer.copyright}</p>
		<p>{t.footer.disclaimer}</p>
	</div>
</footer>
