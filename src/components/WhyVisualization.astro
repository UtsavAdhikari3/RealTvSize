---
import type { Translation } from '../i18n/types';

interface Props {
	t: Translation;
}

const { t } = Astro.props;
---

<section class="border-y border-white/10 bg-[#111] py-24 text-white sm:py-32 dark:bg-[#050505]" aria-labelledby="why-scale-matters">
	<div class="site-shell grid gap-14 lg:grid-cols-[0.9fr_1.1fr] lg:gap-24">
		<div>
			<p class="font-mono text-[11px] uppercase tracking-[0.08em] text-white/60">{t.home.whyEyebrow}</p>
			<h2 id="why-scale-matters" class="mt-4 max-w-xl text-balance text-4xl font-semibold leading-[1.05] tracking-[-0.05em] sm:text-5xl">
				{t.home.whyHeading}
			</h2>
			<p class="mt-5 max-w-xl text-pretty leading-7 text-white/58">{t.home.whyIntro}</p>
		</div>
		<div class="grid gap-px overflow-hidden rounded-2xl border border-white/12 bg-white/12 sm:grid-cols-3">
			<div class="bg-[#111] p-6 dark:bg-[#050505] sm:p-8">
				<span class="font-mono text-xs text-[#50e3c2]">01</span>
				<h3 class="mt-8 text-lg font-medium tracking-[-0.03em]">{t.home.geometryTitle}</h3>
				<p class="mt-3 text-sm leading-6 text-white/50">{t.home.geometryText}</p>
			</div>
			<div class="bg-[#111] p-6 dark:bg-[#050505] sm:p-8">
				<span class="font-mono text-xs text-[#50e3c2]">02</span>
				<h3 class="mt-8 text-lg font-medium tracking-[-0.03em]">{t.home.scaleTitle}</h3>
				<p class="mt-3 text-sm leading-6 text-white/50">{t.home.scaleText}</p>
			</div>
			<div class="bg-[#111] p-6 dark:bg-[#050505] sm:p-8">
				<span class="font-mono text-xs text-[#50e3c2]">03</span>
				<h3 class="mt-8 text-lg font-medium tracking-[-0.03em]">{t.home.fovTitle}</h3>
				<p class="mt-3 text-sm leading-6 text-white/50">{t.home.fovText}</p>
			</div>
		</div>
	</div>
</section>
