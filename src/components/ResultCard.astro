---
interface Props {
	label: string;
	value: string;
	id?: string;
	note?: string;
	accent?: boolean;
}

const { label, value, id, note, accent = false } = Astro.props;
---

<div class:list={['min-w-0 rounded-xl border p-4', accent ? 'border-[var(--text)] bg-[var(--text)] text-[var(--page-bg)]' : 'border-[var(--line)] bg-[var(--surface-soft)] text-[var(--text)]']}>
	<p class:list={['text-xs', accent ? 'text-[var(--page-bg)]/65' : 'text-[var(--text-tertiary)]']}>{label}</p>
	<p id={id} class="number mt-1 break-words text-xl font-medium tracking-[-0.04em]">{value}</p>
	{note && <p class:list={['mt-1 text-xs', accent ? 'text-[var(--page-bg)]/55' : 'text-[var(--text-tertiary)]']}>{note}</p>}
</div>
