---
import CalculatorToolbar from './CalculatorToolbar.astro';
import RangeControl from './RangeControl.astro';
import ResultCard from './ResultCard.astro';
import RoomScene from './RoomScene.astro';
import ViewerPOV from './ViewerPOV.astro';
import { format, horizontalFov, viewProfile, viewingDistance } from '../scripts/tv-math';
import { interpolate } from '../i18n/types';
import type { Translation } from '../i18n/types';

interface Props {
	t: Translation;
	primaryHeading?: boolean;
	initialScreen?: number;
	initialDistance?: number;
	heading?: string;
	intro?: string;
}

const { t, initialScreen = 75, initialDistance = 9.4, primaryHeading = false, heading = t.viewingDistance.heading, intro = t.viewingDistance.intro } = Astro.props;
const Heading = primaryHeading ? 'h1' : 'h2';
const clientTranslations = t;
const locale = Astro.params.lang ?? 'en';
const initialFov = horizontalFov(initialScreen, initialDistance);
const initialFeel = interpolate(t.viewingDistance.feel, { profile: t.profiles[viewProfile(initialFov).key].label, fov: format(initialFov, 0, locale) });
const reference = (mode: 'immersive' | 'balanced' | 'relaxed') => `${format(viewingDistance(initialScreen, mode), 1, locale)} ${t.common.feetShort}`;
const closest = (['immersive', 'balanced', 'relaxed'] as const).reduce((best, mode) => Math.abs(viewingDistance(initialScreen, mode) - initialDistance) < Math.abs(viewingDistance(initialScreen, best) - initialDistance) ? mode : best, 'balanced');
---

<section id="distance" class="section-anchor border-y border-[var(--line)] bg-[var(--surface)] py-28 sm:py-36" data-distance-simulator data-initial-screen={initialScreen} data-initial-distance={initialDistance} data-i18n={JSON.stringify(clientTranslations)}>
	<div class="site-shell">
		<div class="max-w-3xl">
			<p class="eyebrow">{t.viewingDistance.eyebrow}</p>
			<Heading class="mt-4 text-balance text-[clamp(2.3rem,5vw,4.4rem)] font-semibold leading-[1.02] tracking-[-0.055em] text-[var(--text)]">
				{heading}
			</Heading>
			<p class="mt-5 max-w-2xl text-pretty text-base leading-7 text-[var(--text-secondary)] sm:text-lg">
				{intro}
			</p>
		</div>

		<CalculatorToolbar t={t} id="distance" />
		<div class="mt-12 grid items-start gap-5 lg:grid-cols-[minmax(0,1.65fr)_minmax(320px,0.75fr)] lg:gap-6">
			<div class="min-w-0 space-y-4">
				<RoomScene id="distance-room" tvSize={initialScreen} distance={initialDistance} t={t} />
				<ViewerPOV id="distance-pov" tvSize={initialScreen} distance={initialDistance} t={t} />
			</div>

			<div class="panel p-5 sm:p-6">
				<div class="flex items-center justify-between gap-3 border-b border-[var(--line)] pb-5">
					<div>
						<p class="text-sm font-medium text-[var(--text)]">{t.viewingDistance.yourSetup}</p>
						<p id="distance-feel" class="mt-1 text-xs text-[var(--text-tertiary)]">{initialFeel}</p>
					</div>
					<span class="rounded-full border border-[var(--line)] bg-[var(--surface-soft)] px-2.5 py-1 font-mono text-[10px] text-[var(--text-tertiary)]">16:9</span>
				</div>

				<div class="space-y-7 py-6">
					<RangeControl id="distance-tv-size" outputId="distance-tv-output" label={t.viewingDistance.tvSize} min={32} max={115} value={initialScreen} suffix={t.common.inchSymbol} />
					<RangeControl id="viewer-distance" outputId="viewer-distance-output" label={t.viewingDistance.couchDistance} min={3} max={18} step="any" value={initialDistance} displayValue={format(initialDistance, 1, locale)} suffix={` ${t.common.feetShort}`} />
				</div>

				<div class="border-t border-[var(--line)] pt-5">
					<p class="mb-3 text-xs font-medium text-[var(--text-tertiary)]">{t.viewingDistance.jumpToStyle}</p>
					<div class="grid grid-cols-3 gap-2" role="group" aria-label={t.viewingDistance.positionsLabel}>
						<button type="button" data-position="immersive" aria-pressed={closest === 'immersive'} class="position-button rounded-lg border border-[var(--line)] bg-[var(--surface-soft)] p-3 text-left hover:border-[var(--line-strong)]">
							<span class="block text-xs font-medium text-[var(--text)]">{t.profiles.immersive.label}</span>
							<span id="immersive-distance" class="number mt-1 block font-mono text-[10px] text-[var(--text-tertiary)]">{reference('immersive')}</span>
						</button>
						<button type="button" data-position="balanced" aria-pressed={closest === 'balanced'} class="position-button rounded-lg border border-[var(--line)] bg-[var(--surface-soft)] p-3 text-left hover:opacity-90">
							<span class="block text-xs font-medium">{t.profiles.balanced.label}</span>
							<span id="balanced-distance" class="number mt-1 block font-mono text-[10px] opacity-60">{reference('balanced')}</span>
						</button>
						<button type="button" data-position="relaxed" aria-pressed={closest === 'relaxed'} class="position-button rounded-lg border border-[var(--line)] bg-[var(--surface-soft)] p-3 text-left hover:border-[var(--line-strong)]">
							<span class="block text-xs font-medium text-[var(--text)]">{t.profiles.relaxed.label}</span>
							<span id="relaxed-distance" class="number mt-1 block font-mono text-[10px] text-[var(--text-tertiary)]">{reference('relaxed')}</span>
						</button>
					</div>
				</div>
			</div>
		</div>

		<div class="mt-5 grid grid-cols-1 gap-3 sm:grid-cols-3">
			<ResultCard label={t.viewingDistance.immersiveResult} value={reference('immersive')} id="immersive-result" note={t.viewingDistance.immersiveNote} />
			<ResultCard label={t.viewingDistance.balancedResult} value={reference('balanced')} id="balanced-result" note={t.viewingDistance.balancedNote} accent />
			<ResultCard label={t.viewingDistance.relaxedResult} value={reference('relaxed')} id="relaxed-result" note={t.viewingDistance.relaxedNote} />
		</div>
		<p id="distance-live" class="sr-only" aria-live="polite"></p>
	</div>
</section>

<script>
	import '../scripts/viewing-calculators';
</script>
