---
interface Props {
	label: string;
	value: string;
	id?: string;
	vertical?: boolean;
}

const { label, value, id, vertical = false } = Astro.props;
---

<div class:list={['measurement flex items-center gap-2', { 'flex-col': vertical }]}>
	<span class:list={['line', { 'line--vertical': vertical }]} aria-hidden="true"></span>
	<span class="whitespace-nowrap font-mono text-[10px] text-[var(--text-tertiary)]">
		{label} <strong id={id} class="number font-medium text-[var(--text-secondary)]">{value}</strong>
	</span>
</div>

<style>
	.line {
		position: relative;
		width: 100%;
		min-width: 32px;
		height: 1px;
		background: var(--line-strong);
	}

	.line::before,
	.line::after {
		position: absolute;
		top: -2px;
		width: 1px;
		height: 5px;
		background: var(--line-strong);
		content: '';
	}

	.line::before { left: 0; }
	.line::after { right: 0; }

	.line--vertical {
		width: 1px;
		min-width: 1px;
		height: 44px;
	}

	.line--vertical::before,
	.line--vertical::after {
		left: -2px;
		width: 5px;
		height: 1px;
	}

	.line--vertical::before { top: 0; }
	.line--vertical::after { top: auto; bottom: 0; }
</style>
