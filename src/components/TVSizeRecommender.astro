---
import RangeControl from './RangeControl.astro';
import ResultCard from './ResultCard.astro';
import RoomScene from './RoomScene.astro';
import ViewerPOV from './ViewerPOV.astro';
import type { Translation } from '../i18n/types';

interface Props {
	t: Translation;
	primaryHeading?: boolean;
}

const { t, primaryHeading = false } = Astro.props;
const Heading = primaryHeading ? 'h1' : 'h2';
const clientTranslations = {
	common: t.common,
	profiles: t.profiles,
	simulation: t.simulation,
	recommender: {
		modeLabel: t.recommender.modeLabel,
		liveResult: t.recommender.liveResult,
	},
};
---

<section id="find-size" class="section-anchor site-shell py-28 sm:py-36" data-size-recommender data-i18n={JSON.stringify(clientTranslations)}>
	<div class="grid items-end gap-8 lg:grid-cols-[1fr_auto]">
		<div class="max-w-3xl">
			<p class="eyebrow">{t.recommender.eyebrow}</p>
			<Heading class="mt-4 text-balance text-[clamp(2.3rem,5vw,4.4rem)] font-semibold leading-[1.02] tracking-[-0.055em] text-[var(--text)]">
				{t.recommender.heading}
			</Heading>
			<p class="mt-5 max-w-2xl text-pretty text-base leading-7 text-[var(--text-secondary)] sm:text-lg">
				{t.recommender.intro}
			</p>
		</div>
		<div class="rounded-full border border-[var(--line)] bg-[var(--surface)] px-4 py-2 font-mono text-xs text-[var(--text-tertiary)]">
			{t.recommender.basis}
		</div>
	</div>

	<div class="mt-12 grid items-start gap-5 lg:grid-cols-[minmax(300px,0.7fr)_minmax(0,1.45fr)] lg:gap-6">
		<div class="panel order-2 p-5 sm:p-6 lg:order-1">
			<p class="block text-xs font-medium text-[var(--text-tertiary)]">{t.recommender.myCouchIs}</p>
			<div class="mt-2 flex items-end gap-2 border-b border-[var(--line)] pb-5">
				<output id="recommended-distance-hero" for="room-distance" class="number text-5xl font-semibold tracking-[-0.06em] text-[var(--text)]">9.0</output>
				<span class="pb-1 text-sm text-[var(--text-tertiary)]">{t.recommender.feetFromTv}</span>
			</div>

			<div class="py-6">
				<RangeControl id="room-distance" outputId="room-distance-output" label={t.recommender.viewingDistance} min={4} max={18} step={0.1} value={9} suffix={` ${t.common.feetShort}`} />
			</div>

			<div class="border-t border-[var(--line)] pt-5">
				<p class="text-xs font-medium text-[var(--text-tertiary)]">{t.recommender.chooseStyle}</p>
				<div class="mt-3 grid gap-2" role="group" aria-label={t.recommender.stylesLabel}>
					<button type="button" data-recommendation-mode="immersive" aria-pressed="false" class="recommendation-button flex items-center justify-between rounded-lg border border-[var(--line)] bg-[var(--surface-soft)] px-4 py-3 text-left hover:border-[var(--line-strong)]">
						<span><strong class="block text-sm font-medium text-[var(--text)]">{t.profiles.immersive.label}</strong><small class="text-xs text-[var(--text-tertiary)]">{t.recommender.immersiveDetail}</small></span>
						<span id="immersive-size-button" class="number font-mono text-sm text-[var(--text)]">90{t.common.inchSymbol}</span>
					</button>
					<button type="button" data-recommendation-mode="balanced" aria-pressed="true" class="recommendation-button flex items-center justify-between rounded-lg border border-[var(--line)] bg-[var(--surface-soft)] px-4 py-3 text-left hover:opacity-90">
						<span><strong class="block text-sm font-medium">{t.profiles.balanced.label}</strong><small class="text-xs opacity-60">{t.recommender.balancedDetail}</small></span>
						<span id="balanced-size-button" class="number font-mono text-sm">65{t.common.inchSymbol}</span>
					</button>
					<button type="button" data-recommendation-mode="relaxed" aria-pressed="false" class="recommendation-button flex items-center justify-between rounded-lg border border-[var(--line)] bg-[var(--surface-soft)] px-4 py-3 text-left hover:border-[var(--line-strong)]">
						<span><strong class="block text-sm font-medium text-[var(--text)]">{t.profiles.relaxed.label}</strong><small class="text-xs text-[var(--text-tertiary)]">{t.recommender.relaxedDetail}</small></span>
						<span id="relaxed-size-button" class="number font-mono text-sm text-[var(--text)]">55{t.common.inchSymbol}</span>
					</button>
				</div>
			</div>
		</div>

		<div class="order-1 lg:order-2">
			<div class="relative">
				<RoomScene id="recommendation-room" tvSize={65} distance={9} mode="recommendation" t={t} />
				<div class="absolute bottom-4 left-4 z-10 rounded-xl border border-white/10 bg-black/75 px-4 py-3 text-white backdrop-blur-md sm:bottom-6 sm:left-6 sm:px-5 sm:py-4">
					<p class="text-[10px] uppercase tracking-[0.1em] text-white/55">{t.recommender.recommendedTv}</p>
					<p class="mt-1 flex items-baseline gap-1">
						<strong id="recommended-size" class="number text-4xl font-semibold tracking-[-0.06em]">65</strong>
						<span class="text-sm text-white/65">{t.recommender.inches}</span>
					</p>
					<p id="recommended-mode-label" class="mt-1 text-xs text-white/60">{t.recommender.initialMode}</p>
				</div>
			</div>
			<div class="mt-4">
				<ViewerPOV id="recommendation-pov" tvSize={65} distance={9} t={t} />
			</div>
		</div>
	</div>

	<div class="mt-5 grid grid-cols-2 gap-3 lg:grid-cols-5">
		<ResultCard label={t.recommender.recommendedSize} value={`65 ${t.common.inchesShort}`} id="recommended-size-card" accent />
		<ResultCard label={t.recommender.reasonableRange} value={`55–90 ${t.common.inchesShort}`} id="size-range" />
		<ResultCard label={t.profiles.immersive.label} value={`90 ${t.common.inchesShort}`} id="immersive-size-result" note={t.recommender.fieldOfView40} />
		<ResultCard label={t.profiles.balanced.label} value={`65 ${t.common.inchesShort}`} id="balanced-size-result" note={t.recommender.fieldOfView30} />
		<ResultCard label={t.profiles.relaxed.label} value={`55 ${t.common.inchesShort}`} id="relaxed-size-result" note={t.recommender.fieldOfView25} />
	</div>
	<p id="recommendation-live" class="sr-only" aria-live="polite"></p>
</section>

<script>
	import { diagonalForDistance, format, nearestCommonSize, updateUrl } from '../scripts/tv-math';
	import { animateValue, cancelAnimation, updateSimulationVisuals, type SimulationTranslations } from '../scripts/simulation-dom';
	import { interpolate, type Translation } from '../i18n/types';

	const root = document.querySelector<HTMLElement>('[data-size-recommender]');
	if (root) {
		const t = JSON.parse(root.dataset.i18n!) as SimulationTranslations & {
			recommender: Pick<Translation['recommender'], 'modeLabel' | 'liveResult'>;
		};
		const distanceInput = root.querySelector<HTMLInputElement>('#room-distance')!;
		const room = root.querySelector<HTMLElement>('[data-room-scene]')!;
		const pov = root.querySelector<HTMLElement>('[data-viewer-pov]')!;
		const modes = ['immersive', 'balanced', 'relaxed'] as const;
		let selectedMode: (typeof modes)[number] = 'balanced';
		let displayedSize = 65;

		const setText = (selector: string, text: string) => {
			const element = root.querySelector<HTMLElement>(selector);
			if (element) element.textContent = text;
		};

		function styleButtons() {
			root.querySelectorAll<HTMLButtonElement>('[data-recommendation-mode]').forEach((button) => {
				const active = button.dataset.recommendationMode === selectedMode;
				button.setAttribute('aria-pressed', String(active));
				button.style.borderColor = active ? 'var(--text)' : '';
				button.style.background = active ? 'var(--text)' : '';
				button.style.color = active ? 'var(--page-bg)' : '';
				button.querySelectorAll<HTMLElement>('span, strong, small').forEach((span) => {
					span.style.color = active ? 'inherit' : '';
				});
			});
		}

		function render(syncUrl = true, visualSize?: number) {
			const distance = Number(distanceInput.value);
			const recommendations = Object.fromEntries(modes.map((mode) => [mode, nearestCommonSize(diagonalForDistance(distance, mode))])) as Record<(typeof modes)[number], number>;
			const selectedSize = recommendations[selectedMode];
			const simulationSize = visualSize ?? selectedSize;
			const minSize = Math.min(...Object.values(recommendations));
			const maxSize = Math.max(...Object.values(recommendations));
			const { fov, profile } = updateSimulationVisuals(room, pov, simulationSize, distance, 4, t);
			displayedSize = simulationSize;

			root.querySelector<HTMLOutputElement>('#room-distance-output')!.textContent = `${format(distance)}\u00a0${t.common.feetShort}`;
			setText('#recommended-distance-hero', format(distance));
			modes.forEach((mode) => {
				setText(`#${mode}-size-button`, `${recommendations[mode]}${t.common.inchSymbol}`);
				setText(`#${mode}-size-result`, `${recommendations[mode]} ${t.common.inchesShort}`);
			});
			setText('#recommended-size', String(Math.round(simulationSize)));
			setText('#recommended-size-card', `${selectedSize} ${t.common.inchesShort}`);
			setText('#size-range', `${minSize}–${maxSize} ${t.common.inchesShort}`);
			setText('#recommended-mode-label', interpolate(t.recommender.modeLabel, {
				mode: t.profiles[selectedMode].label,
				fov: format(fov, 0),
			}));
			if (syncUrl) {
				setText('#recommendation-live', interpolate(t.recommender.liveResult, {
					distance: format(distance),
					size: selectedSize,
					mode: t.profiles[selectedMode].label,
					fov: format(fov, 0),
					message: profile.message,
				}));
			}
			styleButtons();

			const progress = ((distance - 4) / 14) * 100;
			distanceInput.style.setProperty('--range-progress', `${progress}%`);
			if (syncUrl) updateUrl({ room: distance.toFixed(1), style: selectedMode });
		}

		distanceInput.addEventListener('input', () => render());
		distanceInput.addEventListener('pointerdown', () => cancelAnimation(root));
		root.querySelectorAll<HTMLButtonElement>('[data-recommendation-mode]').forEach((button) => {
			button.addEventListener('click', () => {
				const startSize = displayedSize;
				selectedMode = button.dataset.recommendationMode as typeof selectedMode;
				const distance = Number(distanceInput.value);
				const targetSize = nearestCommonSize(diagonalForDistance(distance, selectedMode));
				animateValue(
					root,
					startSize,
					targetSize,
					(value) => render(false, value),
					() => render(true),
				);
			});
		});
		window.addEventListener('resize', () => render(false), { passive: true });

		const params = new URLSearchParams(location.search);
		const roomDistance = Number(params.get('room'));
		const style = params.get('style');
		if (roomDistance >= 4 && roomDistance <= 18) distanceInput.value = String(roomDistance);
		if (modes.includes(style as typeof selectedMode)) selectedMode = style as typeof selectedMode;
		render(false);
	}
</script>
