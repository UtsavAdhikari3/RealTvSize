---
interface Props {
	id: string;
	label: string;
	min: number;
	max: number;
	step?: number;
	value: number;
	outputId: string;
	suffix: string;
	name?: string;
}

const { id, label, min, max, step = 1, value, outputId, suffix, name = id } = Astro.props;
---

<div class="range-control min-w-0">
	<div class="mb-3 flex items-center justify-between gap-4">
		<label for={id} class="text-sm font-medium text-[var(--text-secondary)]">{label}</label>
		<output id={outputId} for={id} class="number min-w-16 rounded-md border border-[var(--line)] bg-[var(--surface)] px-2.5 py-1 text-right font-mono text-sm text-[var(--text)]">
			{value}{suffix}
		</output>
	</div>
	<input
		id={id}
		name={name}
		type="range"
		min={min}
		max={max}
		step={step}
		value={value}
		autocomplete="off"
		class="range-input"
	/>
	<div class="mt-2 flex justify-between font-mono text-[10px] text-[var(--text-tertiary)]" aria-hidden="true">
		<span>{min}{suffix}</span><span>{max}{suffix}</span>
	</div>
</div>

<style>
	.range-input {
		width: 100%;
		height: 20px;
		margin: 0;
		cursor: pointer;
		appearance: none;
		background: transparent;
	}

	.range-input::-webkit-slider-runnable-track {
		height: 4px;
		border-radius: 999px;
		background: linear-gradient(90deg, var(--text) var(--range-progress, 50%), var(--line) var(--range-progress, 50%));
	}

	.range-input::-moz-range-track {
		height: 4px;
		border-radius: 999px;
		background: var(--line);
	}

	.range-input::-moz-range-progress {
		height: 4px;
		border-radius: 999px;
		background: var(--text);
	}

	.range-input::-webkit-slider-thumb {
		width: 18px;
		height: 18px;
		margin-top: -7px;
		appearance: none;
		border: 4px solid var(--surface);
		border-radius: 50%;
		background: var(--text);
		box-shadow: 0 0 0 1px var(--line-strong), 0 2px 6px rgb(0 0 0 / 0.16);
	}

	.range-input::-moz-range-thumb {
		width: 11px;
		height: 11px;
		border: 4px solid var(--surface);
		border-radius: 50%;
		background: var(--text);
		box-shadow: 0 0 0 1px var(--line-strong), 0 2px 6px rgb(0 0 0 / 0.16);
	}

	.range-input:focus-visible {
		outline: none;
	}

	.range-input:focus-visible::-webkit-slider-thumb {
		box-shadow: 0 0 0 3px var(--page-bg), 0 0 0 5px #0070f3;
	}

	.range-input:focus-visible::-moz-range-thumb {
		box-shadow: 0 0 0 3px var(--page-bg), 0 0 0 5px #0070f3;
	}
</style>
