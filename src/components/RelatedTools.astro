---
import { getTranslation, isLanguage, type Language } from '../i18n/config';
import { localizedPath, type PageId } from '../i18n/routes';
import { getSeoCopy } from '../data/seo';
interface Props { current?: PageId; lang?: Language }
const { current, lang = isLanguage(Astro.params.lang) ? Astro.params.lang : 'en' } = Astro.props;
const t = getTranslation(lang), copy = await getSeoCopy(lang);
const tools = [
 { page: 'home', label: t.navigation.home },
 { page: 'tvSizes', label: copy.labels.sizes },
 { page: 'compare', label: t.navigation.compare },
 { page: 'viewingDistance', label: t.navigation.viewingDistance },
 { page: 'findMyTvSize', label: t.navigation.findMyTvSize },
 { page: 'willItFit', label: t.navigation.willItFit },
 ...(lang === 'en' ? [{ page: 'methodology', label: 'Calculation methodology' }] : []),
] as { page: PageId; label: string }[];
---
<aside class="site-shell py-12 sm:py-16">
 <nav class="mx-auto max-w-3xl" aria-label={copy.labels.tools}>
  <h2 class="text-lg font-semibold">{copy.labels.tools}</h2>
  <ul class="mt-4 grid gap-3 text-sm text-[var(--text-secondary)] sm:grid-cols-2">
   {tools.filter(tool => tool.page !== current).map(tool => <li><a class="underline underline-offset-4" href={localizedPath(lang, tool.page)}>{tool.label}</a></li>)}
  </ul>
 </nav>
</aside>
